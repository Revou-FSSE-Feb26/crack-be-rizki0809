// Skema database Hadish Cake - booking system toko kue.
// Dokumentasi: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

// URL koneksi tidak ditulis di sini lagi (aturan Prisma 7), tapi di prisma.config.ts.
datasource db {
  provider = "postgresql"
}

/// ADMIN = penjual (kelola menu & orderan), CUSTOMER = pembeli.
enum Role {
  ADMIN
  CUSTOMER
}

/// Alur order: PENDING -> CONFIRMED -> READY -> COMPLETED, atau CANCELLED.
enum OrderStatus {
  PENDING /// baru masuk, menunggu konfirmasi admin
  CONFIRMED /// sudah dikonfirmasi admin, kue diproses
  READY /// kue siap diambil di toko
  COMPLETED /// sudah diambil customer
  CANCELLED /// dibatalkan
}

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  /// Selalu berisi hash bcrypt, tidak pernah password mentah.
  password  String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  /// Dipakai frontend sebagai filter di URL, misal "birthday".
  slug      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  emoji     String   @db.VarChar(16)
  /// Kelas warna Tailwind yang dipakai kartu di frontend, misal "bg-butter-100".
  tone      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(120)
  description String  @db.VarChar(255)
  /// Harga dalam rupiah penuh (integer), bukan desimal, supaya tidak ada galat pembulatan.
  price       Int
  emoji       String  @db.VarChar(16)
  tone        String  @db.VarChar(50)
  bestSeller  Boolean @default(false) @map("best_seller")
  /// Admin bisa menyembunyikan menu sementara tanpa menghapusnya.
  isAvailable Boolean @default(true) @map("is_available")
  /// Diisi saat menu dihapus tapi masih dipakai order lama (soft delete).
  deletedAt   DateTime? @map("deleted_at")

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([deletedAt])
  @@map("products")
}

model Order {
  id          String @id @default(uuid())
  /// Nomor order yang dilihat customer, misal "HC-20260918-A3F1".
  orderNumber String @unique @map("order_number") @db.VarChar(30)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Tanggal customer mengambil kue di toko (tanpa jam).
  pickupDate DateTime    @map("pickup_date") @db.Date
  status     OrderStatus @default(PENDING)
  /// Total harga = jumlah subtotal seluruh item, disimpan agar history tidak berubah.
  totalPrice Int         @map("total_price")
  notes      String?     @db.VarChar(255)

  items OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([pickupDate])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  quantity Int
  /// Snapshot harga produk saat order dibuat, supaya history order tidak ikut
  /// berubah ketika admin mengubah harga menu.
  unitPrice Int @map("unit_price")
  subtotal  Int

  @@unique([orderId, productId])
  @@index([orderId])
  @@map("order_items")
}
