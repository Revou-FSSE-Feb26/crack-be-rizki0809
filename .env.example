# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Koneksi PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/hadish_cake?schema=public"

# Port server NestJS
PORT=3001

# Origin frontend Next.js yang diizinkan mengakses API
CORS_ORIGIN="http://localhost:3000"

# Kunci rahasia untuk menandatangani JWT.
# Buat nilai acak dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="ganti-dengan-string-acak-yang-panjang"
# Masa berlaku token, contoh: 60s, 30m, 7d
JWT_EXPIRES_IN="7d"
