# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Koneksi PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/hadish_cake?schema=public"

# Port server NestJS
PORT=3001

# Origin frontend Next.js yang diizinkan mengakses API
CORS_ORIGIN="http://localhost:3000"
